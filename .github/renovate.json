{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "enabledManagers": [
    "argocd",
    "helm-values",
    "docker-compose"
  ],
  "argocd": {
    "managerFilePatterns": [
      "/^kubernetes/argocd/clusters/components/.+\\.yaml$/"
    ]
  },
  "helm-values": {
    "managerFilePatterns": [
      "/^kubernetes/argocd/clusters/addons/.+/values\\.yaml$/"
    ]
  },
  "docker-compose": {
    "managerFilePatterns": [
      "/^docker/.+/docker-compose\\.ya?ml$/"
    ]
  },
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "semanticCommits": "disabled",
  "commitMessageAction": "update",
  "automergeType": "pr",
  "platformAutomerge": false,
  "automergeStrategy": "rebase",
  "ignoreTests": true,
  "packageRules": [
    {
      "matchManagers": [
        "argocd"
      ],
      "commitMessageTopic": "{{depName}}"
    },
    {
      "matchUpdateTypes": [
        "patch"
      ],
      "automerge": true
    },
    {
      "matchFileNames": [
        "kubernetes/argocd/clusters/components/software-base/istio*.yaml"
      ],
      "groupName": "istio"
    }
  ]
}
